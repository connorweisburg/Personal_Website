<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title>Weisburg Productions</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="music-body">

  <!-- Navigation -->

  <%- include("partials/nav") %>

  <!-- Logo -->

  <img
    src="/images/wp_logo.png"
    alt="Weisburg Productions Logo"
    class="logo"
  >

  <!-- Checkerboard -->

  <div class="checkerboard left"></div>
  <div class="checkerboard right"></div>

  <div class="content">

    <!-- Hero -->

    <section class="hero music-hero">

      <h1>Weisburg Productions</h1>

      <p class="music-tagline">
        Thoughtful music production, licensing,
        and creative collaboration.
      </p>

      <a href="#music" class="cta music-cta">
        Explore Catalog
      </a>

    </section>

    <!-- Philosophy -->

    <section class="music-intro">

      <h2>The Approach</h2>

      <p>
        Great productions begin with understanding.
        Every artist, project, and story has its own
        identity. The goal isn't to impose a sound—
        it's to uncover one.
      </p>

    </section>

    <!-- Catalog -->

    <section id="music">

      <h2 class="section-title">Featured Tracks</h2>

      <div class="catalog">

        <div class="track">
          <h3>The Gleamers — How It Goes</h3>
          <p>Moody • Grungy • Uplifting • Rock</p>

          <iframe
            src="https://open.spotify.com/embed/track/0VOdfmSPNpAIUBLl9RnPSe"
            width="100%"
            height="152"
            frameborder="0"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy">
          </iframe>
        </div>

        <div class="track">
          <h3>Needle Found — Please</h3>
          <p>Mournful • Emotional • Melancholic</p>

          <iframe
            src="https://open.spotify.com/embed/track/0eNEx7u2gYQuW2nadHQ2ez"
            width="100%"
            height="152"
            frameborder="0"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy">
          </iframe>
        </div>

        <div class="track">
          <h3>SEMPAR — Runner Up</h3>
          <p>Upbeat • Catchy • Energetic • Indie Rock</p>

          <iframe
            src="https://open.spotify.com/embed/track/07Uq9UKL8jb0PpkLpsJMC8"
            width="100%"
            height="152"
            frameborder="0"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy">
          </iframe>
        </div>

      </div>

    </section>

    <!-- Process -->

    <section class="music-intro">

      <h2>Production Philosophy</h2>

      <p>
        Music sits at the intersection of craft and discovery.
        The best projects emerge from trust, experimentation,
        and a commitment to serving the song first.
      </p>

    </section>

    <!-- Contact -->

    <section class="contact">

      <h2>Let's craft a common vision</h2>

      <p>
        Reach out regarding production,
        licensing opportunities, or collaboration.
      </p>

      <p>
        <strong>Email:</strong>
        connorweisburg@gmail.com
      </p>

      <p>
        <a
          href="https://cerulean-iridium-a80.notion.site/2fc67645e3e680139d79cd0fb5358be4?v=2fc67645e3e680439a90000c1cb1187b&pvs=74"
          target="_blank"
          rel="noopener noreferrer">
          View Production Workflow →
        </a>
      </p>

    </section>

  </div>

  <script src="/js/checkerboard.js"></script>

</body>
</html>